# Copia este fichero a .env y rellena tus valores. NO subas .env al repositorio.

# Puerto del servicio
PUERTO=3001

# Secreto compartido con la app (el mismo que pones en el conector, modo Servidor).
# Genera uno largo y aleatorio, p. ej.:  openssl rand -hex 32
SECRETO=cambia-esto-por-un-secreto-largo

# Origen permitido para CORS: la URL exacta de tu app.
# Ejemplo GitHub Pages:
ORIGEN_PERMITIDO=https://voleyplayaponiente-glitch.github.io

# ── Copias de seguridad de la app ──
# Carpeta DENTRO del contenedor donde se guardan (el docker-compose la monta
# desde ./datos, así que las copias sobreviven a recrear el contenedor).
COPIAS_DIR=/datos
# Cuántas copias se conservan por empresa (una por día).
COPIAS_RETENCION=30
# Tope de tamaño de una copia, en bytes (50 MB por defecto).
COPIAS_MAX_BYTES=52428800

# ── Square ──
# Token de acceso de Square (Dashboard de Square > Credenciales).
SQUARE_TOKEN=
# production | sandbox
SQUARE_ENV=production
# Opcional: limita a una localización concreta
SQUARE_LOCATION_ID=
# Versión de la API de Square (fecha)
SQUARE_VERSION=2024-10-17
