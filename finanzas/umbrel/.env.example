# Copia este fichero a .env y rellena el secreto. NO se sube al repositorio.

# Puerto del Umbrel por el que entrarás a la app.
# Ocupados por otras aplicaciones: 3000 (gestión laboral), 3001, 3002, 3006,
# 3010 y 3063. Comprueba antes con:  sudo ss -lntp | grep 3011
PUERTO_HOST=3011

# Secreto de las copias. Genera uno corto y fácil de teclear con:
#   head -c 1000 /dev/urandom | LC_ALL=C tr -dc 'ABCDEFGHJKMNPQRSTUVWXYZ23456789' | head -c 20 | sed 's/.\{5\}/&-/g; s/-$//'
SECRETO=CAMBIA-ESTO-POR-UN-SECRETO

# Puerto interno del servicio de copias. No hace falta tocarlo.
PUERTO=3001

# Origen permitido para CORS. Sirviendo la app desde el propio Umbrel, la
# petición es del mismo origen y esto deja de hacer falta; se queda por si algún
# día se usa la app de GitHub Pages contra este mismo servidor.
ORIGEN_PERMITIDO=https://voleyplayaponiente-glitch.github.io

# Copias
COPIAS_DIR=/datos
COPIAS_RETENCION=30
COPIAS_MAX_BYTES=52428800
