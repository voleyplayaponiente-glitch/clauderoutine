# Imagen de la aplicación: nginx con la interfaz compilada.
#
# El contexto de build es la carpeta `norte/` entera porque la app depende del
# paquete `@norte/dominio` del monorepo.
FROM node:22-slim AS build
WORKDIR /repo

# Primero los manifiestos: así una compilación sin cambios en las dependencias
# reaprovecha la capa y tarda segundos en vez de minutos.
COPY package.json package-lock.json tsconfig.base.json ./
COPY dominio/package.json dominio/
COPY api/package.json api/
COPY app/package.json app/
RUN npm ci --ignore-scripts

COPY dominio dominio
COPY app app
# El `prebuild` de @norte/app ya compila el dominio del que depende.
RUN npm run build -w @norte/app

FROM nginx:1.27-alpine
COPY --from=build /repo/app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
