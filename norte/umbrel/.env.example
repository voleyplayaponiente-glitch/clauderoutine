# Copia este fichero a `.env` y rellena los dos secretos antes de levantar nada.
#
# Genera cada uno con:
#   openssl rand -base64 36
#
# Guárdalos: si pierdes POSTGRES_PASSWORD no se pierden los datos (están en el
# volumen), pero la base de datos no arrancará hasta que lo repongas.

# Contraseña de PostgreSQL. Solo se usa entre contenedores; no se escribe en
# ningún sitio más.
POSTGRES_PASSWORD=cambia-esto

# Firma las sesiones. Cambiarlo cierra la sesión de todo el mundo (que es
# justo lo que quieres si crees que se ha filtrado). Mínimo 32 caracteres.
NORTE_SECRETO_SESION=cambia-esto-por-al-menos-32-caracteres

# Puerto por el que entrarás a Norte desde el navegador.
PUERTO_HOST=3012

# Cookies con `secure`: déjalo en false si entras por http:// en la red de casa,
# que es lo normal en el Umbrel. Ponlo a true solo si sirves Norte por HTTPS.
NORTE_COOKIE_SEGURA=false
